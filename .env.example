# 제주 동네 상권 진단 Agent — 환경 설정 예시
# 이 파일을 `.env`로 복사해 값을 채운다. 비어 있으면 규칙 모드(LLM 없이)로 동작한다.

# --- 서버 ---
# 접속 주소·포트. 센터 PC에서는 기본값(127.0.0.1:8765) 그대로 두면 된다.
HOST=127.0.0.1
PORT=8765
# 시작할 때 기본 브라우저를 열지 여부(true/false)
OPEN_BROWSER=true
# 로그·업로드 임시 폴더(비우면 앱 폴더의 runtime/)
RUNTIME_DIR=

# --- 외부 LLM (OpenAI 호환) ---
# 예: https://api.openai.com/v1
LLM_BASE_URL=
# 비워 두면 LLM을 쓰지 않고 규칙 모드로 답한다.
LLM_API_KEY=
# 예: gpt-4o-mini
LLM_MODEL=

# --- 제주데이터허브 Open API ---
# 허브 프로젝트 키. 없으면 동봉 스냅샷(sample_data/hub/)만 쓴다.
HUB_API_KEY=
# 기본 https://open.jejudatahub.net/api/proxy/
HUB_BASE_URL=

# --- 개인정보 경계 ---
# off(기본): 센터 업로드 데이터 값은 LLM에 보내지 않는다.
# aggregates: 반출 점검을 통과한 집계값만 보낼 수 있다.
CENTER_TO_LLM=off
